# Reddit script app -> https://www.reddit.com/prefs/apps  (type: "script")
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
# Descriptive UA per Reddit API rules; include your username
REDDIT_USER_AGENT=windows:reader.selfhosted:v1.0 (by /u/your_reddit_username)
